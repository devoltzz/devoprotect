{
 "entry": "DevoProtect.py",
 "engine_dir": "engine",
 "icon": "assets/devoprotect.ico",
 "config_var": "DEVOPROTECT_WEB",
 "inject_before": "<script src=\"i18n_data.js\"></script>",
 "inject": [
  "config.js",
  "ponte.js"
 ],
 "head_anchor": "</head>",
 "web_files": [
  "ponte.js",
  "worker.js",
  "worker.py",
  "wasi_mini.js",
